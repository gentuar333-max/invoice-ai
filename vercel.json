{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.invoiceagent.fr"
        }
      ],
      "destination": "https://invoiceagent.fr/:path*",
      "permanent": true
    }
  ]
}